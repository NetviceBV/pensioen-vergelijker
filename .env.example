
# Allianz-credentials per omgeving. Kopieer dit bestand naar `.env` en vul in.
# Deze variabelen blijven server-side (dev-proxy) en komen nooit in de client-bundel.

ALLIANZ_ACCEPTATIE_USERNAME=jouw-acc-gebruikersnaam
ALLIANZ_ACCEPTATIE_PASSWORD=jouw-acc-wachtwoord

