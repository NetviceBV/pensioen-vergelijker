
# Allianz-credentials per omgeving. Kopieer dit bestand naar `.env` en vul in.
# Deze variabelen blijven server-side (dev-proxy) en komen nooit in de client-bundel.

ALLIANZ_ACCEPTATIE_USERNAME=jouw-acc-gebruikersnaam
ALLIANZ_ACCEPTATIE_PASSWORD=jouw-acc-wachtwoord

# ALLIANZ_TEST_USERNAME=
# ALLIANZ_TEST_PASSWORD=
# ALLIANZ_PRODUCTIE_USERNAME=
# ALLIANZ_PRODUCTIE_PASSWORD=

# a.s.r. (BMS/eBenefits) authenticeert met een CLIENT-CERTIFICAAT (mTLS), niet met wachtwoord.
# Lever het PFX-bestand aan als pad (lokaal/dev) OF als base64 (bijv. Vercel), plus de passphrase.
# ASR heeft geen apart test-endpoint; 'test' valt terug op de acceptatie(staging)-omgeving.
ASR_PFX_PATH=./certs/asr-client.pfx
ASR_PFX_PASSPHRASE=jouw-pfx-passphrase
# Alternatief voor omgevingen zonder bestandssysteem (Vercel):
# ASR_PFX_BASE64=<base64 van het .pfx-bestand>
# Env-specifiek kan ook: ASR_ACCEPTATIE_PFX_PATH / ASR_PRODUCTIE_PFX_PATH etc.

# a.s.r. whitelist't op IP-adres. Vercel Functions hebben geen vast uitgaand IP —
# zet daarom in Vercel (niet lokaal nodig, je eigen IP is al gewhitelist) de
# proxy-URL van een vaste-IP-proxy zoals Fixie (https://www.fixie.dev):
# FIXIE_URL=http://user:pass@criterium.usefixie.com:80
